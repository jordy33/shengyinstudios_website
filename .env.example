# Shengyin Studios — plantilla de variables de entorno
#
# Copia este archivo a `.env` y llena los valores reales:
#
#   cp .env.example .env
#
# El `.env` NO se sube al repo (está en .gitignore).
# En el servidor, estas variables viven en /etc/supervisor/conf.d/shengyin.conf

NODE_ENV=production
PORT=7008

# --- Base de datos ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
DB_NAME=shengyingstudios

# --- Token del MCP ------------------------------------------------------
# Genera uno con:  openssl rand -hex 32
#
# Obligatorio. Si falta, el MCP se cierra (fail closed) en lugar de quedar
# abierto — la superficie incluye SQL libre, así que nunca debe estar público.
MCP_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# --- Token opcional del dashboard --------------------------------------
# Si está vacío, /stats y /api/stats quedan abiertos (solo agregados).
STATS_TOKEN=

# --- Sal para el hash de visitantes ------------------------------------
# Nunca se guardan IPs: se hashean con esta sal, rotando cada día.
VISITOR_SALT=REPLACE_WITH_ALGO_ALEATORIO
